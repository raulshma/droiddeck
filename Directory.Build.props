<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <DroidDeckWindowsTargetFramework>net10.0-windows10.0.26100.0</DroidDeckWindowsTargetFramework>
    <DroidDeckWindowsMinVersion>10.0.17763.0</DroidDeckWindowsMinVersion>
    <DroidDeckWindowsAppSdkVersion>2.5.1</DroidDeckWindowsAppSdkVersion>
    <DroidDeckVersion>0.0.1-alpha</DroidDeckVersion>
    <Version>$(DroidDeckVersion)</Version>
    <DroidDeckRepositoryUrl>https://github.com/raulshma/droiddeck</DroidDeckRepositoryUrl>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>
</Project>
