<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(DroidDeckWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(DroidDeckWindowsMinVersion)</TargetPlatformMinVersion>
    <RootNamespace>DroidDeck.App</RootNamespace>
    <AssemblyName>DroidDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DroidDeck.Core\DroidDeck.Core.csproj" />
    <ProjectReference Include="..\DroidDeck.Adb\DroidDeck.Adb.csproj" />
    <ProjectReference Include="..\DroidDeck.Projects\DroidDeck.Projects.csproj" />
    <ProjectReference Include="..\DroidDeck.Screen\DroidDeck.Screen.csproj" />
    <ProjectReference Include="..\DroidDeck.Plugins\DroidDeck.Plugins.csproj" />
    <ProjectReference Include="..\DroidDeck.Plugin.Abstractions\DroidDeck.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\DroidDeck.Plugin.UI\DroidDeck.Plugin.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
</Project>
