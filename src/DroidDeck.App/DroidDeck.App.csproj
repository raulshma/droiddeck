<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(DroidDeckWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(DroidDeckWindowsMinVersion)</TargetPlatformMinVersion>
    <RootNamespace>DroidDeck.App</RootNamespace>
    <AssemblyName>DroidDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DroidDeck.Core\DroidDeck.Core.csproj" />
    <ProjectReference Include="..\DroidDeck.Adb\DroidDeck.Adb.csproj" />
    <ProjectReference Include="..\DroidDeck.Projects\DroidDeck.Projects.csproj" />
    <ProjectReference Include="..\DroidDeck.Screen\DroidDeck.Screen.csproj" />
    <ProjectReference Include="..\DroidDeck.Plugins\DroidDeck.Plugins.csproj" />
    <ProjectReference Include="..\DroidDeck.Plugin.Abstractions\DroidDeck.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\DroidDeck.Plugin.UI\DroidDeck.Plugin.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="WindowsAppSdkVersion" Value="$(DroidDeckWindowsAppSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(RepoRoot)LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(RepoRoot)Licenses\**\*" Link="Licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWindowsAppSdkNotices" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\license.txt"
          DestinationFiles="$(OutDir)Licenses\WINDOWSAPPSDK-LICENSE.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\license.txt')" />
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\NOTICE.txt"
          DestinationFiles="$(OutDir)Licenses\WINDOWSAPPSDK-NOTICES.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\NOTICE.txt')" />
  </Target>

  <Target Name="CopyWindowsAppSdkNoticesToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\license.txt"
          DestinationFiles="$(PublishDir)Licenses\WINDOWSAPPSDK-LICENSE.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\license.txt')" />
    <Copy SourceFiles="$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\NOTICE.txt"
          DestinationFiles="$(PublishDir)Licenses\WINDOWSAPPSDK-NOTICES.txt"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)microsoft.windowsappsdk\$(DroidDeckWindowsAppSdkVersion)\NOTICE.txt')" />
  </Target>

  <!-- Publish does not carry the XAML compiler output; without the XBF tree and
       the app PRI, MainWindow.LoadComponent fails at startup. -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WinUIXbf Include="$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(WinUIXbf)"
          DestinationFiles="@(WinUIXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>
</Project>
