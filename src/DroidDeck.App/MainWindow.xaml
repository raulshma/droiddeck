<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DroidDeck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragEnter="OnRootDragOver"
        DragLeave="OnRootDragLeave"
        DragOver="OnRootDragOver"
        Drop="OnRootDrop"
        KeyDown="OnRootKeyDown"
        TabFocusNavigation="Cycle">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" MinHeight="34" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Grid.Row="0"
            Padding="16,0,150,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <TextBlock
                    Text="DroidDeck"
                    FontSize="14"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="TitleStatusText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="12"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>

        <MenuBar
            x:Name="ShellMenuBar"
            Grid.Row="1"
            AutomationProperties.AutomationId="MainMenu"
            AutomationProperties.Name="{StaticResource Loc.shell.menu.name}" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="260"
            SelectionChanged="OnNavigationSelectionChanged"
            AutomationProperties.AutomationId="MainNavigation"
            AutomationProperties.Name="{StaticResource Loc.shell.navigation.name}">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.home}"
                    AccessKey="H"
                    Tag="home"
                    AutomationProperties.AutomationId="NavHome">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.devices}"
                    AccessKey="D"
                    Tag="devices"
                    AutomationProperties.AutomationId="NavDevices">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Phone" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.multi-device}"
                    AccessKey="M"
                    Tag="multi-device"
                    AutomationProperties.AutomationId="NavMultiDevice">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.emulators}"
                    AccessKey="E"
                    Tag="devices/emulators"
                    AutomationProperties.AutomationId="NavEmulators">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Phone" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.wireless}"
                    AccessKey="W"
                    Tag="devices/wireless"
                    AutomationProperties.AutomationId="NavWireless">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="World" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.projects}"
                    AccessKey="P"
                    Tag="projects"
                    AutomationProperties.AutomationId="NavProjects">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.tests}"
                    AccessKey="T"
                    Tag="tests"
                    AutomationProperties.AutomationId="NavTests">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.history}"
                    AccessKey="Y"
                    Tag="history"
                    AutomationProperties.AutomationId="NavHistory">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.activity}"
                    AccessKey="A"
                    Tag="activity"
                    AutomationProperties.AutomationId="NavActivity">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.extensions}"
                    AccessKey="X"
                    Tag="extensions"
                    AutomationProperties.AutomationId="NavExtensions">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="AllApps" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.catalog}"
                    AccessKey="C"
                    Tag="catalog"
                    AutomationProperties.AutomationId="NavCatalog">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.settings}"
                    AccessKey="S"
                    Tag="settings"
                    AutomationProperties.AutomationId="NavSettings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.diagnostics}"
                    AccessKey="G"
                    Tag="diagnostics"
                    AutomationProperties.AutomationId="NavDiagnostics">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Repair" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{StaticResource Loc.shell.nav.about}"
                    AccessKey="B"
                    Tag="about"
                    AutomationProperties.AutomationId="NavAbout">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <ContentControl
                    x:Name="PageHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="PageHost" />
            </NavigationView.Content>
        </NavigationView>

        <InfoBar
            x:Name="NotificationBar"
            Grid.Row="2"
            MaxWidth="380"
            MinWidth="240"
            Margin="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="NotificationBar"
            AutomationProperties.LiveSetting="Polite">
            <InfoBar.ActionButton>
                <Button
                    x:Name="NotificationActionButton"
                    Content="{StaticResource Loc.shell.action.view}"
                    Click="OnNotificationActionClick"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="NotificationActionButton" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid
            Grid.Row="3"
            Padding="12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                Grid.Column="0"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                AutomationProperties.AutomationId="StatusBarScroll">
                <Grid ColumnSpacing="16" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="AdbStatusText"
                        Text="{StaticResource Loc.shell.status.adb-starting}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.AutomationId="AdbStatus"
                        AutomationProperties.LiveSetting="Polite" />
                    <TextBlock
                        x:Name="DeviceCountText"
                        Grid.Column="1"
                        Text="{StaticResource Loc.shell.status.device-many}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.AutomationId="DeviceCount"
                        AutomationProperties.LiveSetting="Polite" />
                    <TextBlock
                        x:Name="FallbackStatusText"
                        Grid.Column="2"
                        Text=""
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="StatusMessageText"
                        Grid.Column="3"
                        Text=""
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </ScrollViewer>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10"
                VerticalAlignment="Center">
                <StackPanel
                    x:Name="PluginStatusBarPanel"
                    Orientation="Horizontal"
                    Spacing="16"
                    VerticalAlignment="Center" />
                <Button
                    x:Name="InstallApkButton"
                    Content="{StaticResource Loc.shell.action.install-apk}"
                    FontSize="12"
                    Padding="10,2"
                    Click="OnInstallApkClick"
                    AccessKey="I"
                    ToolTipService.ToolTip="{StaticResource Loc.shell.action.install-apk-tooltip}"
                    AutomationProperties.AutomationId="InstallApkButton" />
                <Button
                    x:Name="FinishSetupButton"
                    Content="{StaticResource Loc.shell.action.finish-setup}"
                    FontSize="12"
                    Padding="10,2"
                    Click="OnFinishSetupClick"
                    AccessKey="F"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="FinishSetupButton" />
                <TextBlock
                    x:Name="DiagnosticsIdText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    AutomationProperties.AutomationId="DiagnosticsId" />
                <Button
                    x:Name="CopyDiagnosticsButton"
                    Content="{StaticResource Loc.shell.action.copy-diagnostics}"
                    FontSize="12"
                    Padding="10,2"
                    Click="OnCopyDiagnosticsClick"
                    AccessKey="C"
                    AutomationProperties.AutomationId="CopyDiagnosticsButton" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="DropOverlay"
            Grid.RowSpan="4"
            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="560"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    Glyph="&#xE896;"
                    FontSize="44"
                    HorizontalAlignment="Center" />
                <TextBlock
                    x:Name="DropTitleText"
                    Text="{StaticResource Loc.shell.drop.title}"
                    FontSize="24"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock
                    x:Name="DropSubtitleText"
                    Text="{StaticResource Loc.shell.drop.subtitle}"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
