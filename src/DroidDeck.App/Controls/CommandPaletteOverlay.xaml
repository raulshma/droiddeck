<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DroidDeck.App.Controls.CommandPaletteOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:DroidDeck.App.ViewModels"
    mc:Ignorable="d"
    IsTabStop="False"
    AutomationProperties.AutomationId="CommandPalette">

    <Grid
        x:Name="OverlayRoot"
        Visibility="Collapsed"
        KeyDown="OnOverlayKeyDown"
        AutomationProperties.Name="{StaticResource Loc.palette.name}">
        <Grid Background="{ThemeResource SmokeFillColorDefaultBrush}" Tapped="OnBackdropTapped" />
        <Border
            MaxWidth="560"
            MaxHeight="520"
            Margin="24,0,24,140"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="QueryBox"
                    Grid.Row="0"
                    PlaceholderText="{StaticResource Loc.palette.query-placeholder}"
                    TextChanged="OnQueryTextChanged"
                    KeyDown="OnQueryKeyDown"
                    AutomationProperties.AutomationId="CommandPaletteQuery"
                    AutomationProperties.Name="{StaticResource Loc.palette.query-name}" />
                <Grid Grid.Row="1">
                    <ListView
                        x:Name="ResultsList"
                        MaxHeight="380"
                        SelectionMode="Single"
                        IsItemClickEnabled="True"
                        ItemClick="OnResultItemClick"
                        AutomationProperties.AutomationId="CommandPaletteResults"
                        AutomationProperties.Name="{StaticResource Loc.palette.results-name}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:CommandPaletteRow">
                                <Grid ColumnSpacing="12" Padding="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Command.Title}"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{x:Bind Detail}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{x:Bind ShortcutVisibility}">
                                        <TextBlock
                                            Text="{x:Bind Shortcut}"
                                            FontFamily="Consolas"
                                            FontSize="12" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="EmptyText"
                        Text="{StaticResource Loc.palette.empty}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="CommandPaletteEmpty" />
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Text="{StaticResource Loc.palette.hint}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
