<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <StackPanel Spacing="2">
                <TextBlock Text="Home" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="SubtitleText"
                    Text="Starting up."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar
                x:Name="LoadNoticeBar"
                Severity="Warning"
                Title="Settings recovered"
                IsOpen="False"
                IsClosable="True"
                AutomationProperties.AutomationId="HomeSettingsNotice" />
            <InfoBar
                x:Name="ActionBar"
                Severity="Success"
                IsOpen="False"
                IsClosable="True"
                AutomationProperties.AutomationId="HomeActionBar" />

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Devices" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="DeviceSummaryText"
                            Text="No devices connected."
                            Style="{StaticResource FieldValueStyle}"
                            AutomationProperties.AutomationId="HomeDevicesSummary" />
                        <TextBlock
                            x:Name="AdbSummaryText"
                            Text="ADB is starting."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RefreshDevicesButton"
                                Content="Refresh devices"
                                Click="OnRefreshDevicesClick"
                                AutomationProperties.AutomationId="HomeRefreshDevicesButton" />
                            <Button
                                Content="Open devices"
                                Click="OnOpenDevicesClick"
                                AutomationProperties.AutomationId="HomeOpenDevicesButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Toolchain" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="ToolchainSummaryText"
                            Text="Toolchain check is starting."
                            Style="{StaticResource FieldValueStyle}"
                            AutomationProperties.AutomationId="HomeToolchainSummary" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CheckToolchainButton"
                                Content="Check toolchain"
                                Click="OnCheckToolchainClick"
                                AutomationProperties.AutomationId="HomeCheckToolchainButton" />
                            <Button
                                Content="Tool settings"
                                Click="OnOpenSettingsClick"
                                AutomationProperties.AutomationId="HomeOpenSettingsButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Extensions" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="ExtensionsSummaryText"
                            Text="Plugin scan is starting."
                            Style="{StaticResource FieldValueStyle}"
                            AutomationProperties.AutomationId="HomePluginsSummary" />
                        <Button
                            Content="Open extensions"
                            Click="OnOpenExtensionsClick"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="HomeOpenExtensionsButton" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="DiagnosticsSummaryText"
                            Text="Preparing diagnostics."
                            Style="{StaticResource FieldValueStyle}"
                            AutomationProperties.AutomationId="HomeDiagnosticsSummary" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Copy diagnostics"
                                Click="OnCopyDiagnosticsClick"
                                AutomationProperties.AutomationId="HomeCopyDiagnosticsButton" />
                            <Button
                                Content="Open diagnostics"
                                Click="OnOpenDiagnosticsClick"
                                AutomationProperties.AutomationId="HomeOpenDiagnosticsButton" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
