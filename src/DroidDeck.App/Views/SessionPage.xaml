<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.SessionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DroidDeck.App.Views">

    <Page.Resources>
        <DataTemplate x:Key="StepRowTemplate">
            <Grid Padding="8,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{Binding Name}"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{Binding CommandLine}"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{Binding Error}"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{Binding SkipReason}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="{Binding HasSkipReason, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock
                        Text="{Binding DiagnosisText}"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl
                        ItemsSource="{Binding RecoveryRows}"
                        Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding Label}"
                                    Click="OnRecoveryClick"
                                    ToolTipService.ToolTip="{Binding Description}"
                                    AutomationProperties.AutomationId="{Binding AutomationId}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Spacing="2"
                    HorizontalAlignment="Right">
                    <TextBlock
                        Text="{Binding StateLabel}"
                        FontSize="12"
                        Foreground="{Binding StateBrush}" />
                    <TextBlock
                        Text="{Binding DurationLabel}"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CrashRowTemplate">
            <Grid Padding="8,6" ColumnSpacing="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        Text="{Binding KindLabel}"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        Text="{Binding Summary}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding TimeLabel}"
                    FontSize="11"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>
        <views:TimelineTemplateSelector
            x:Key="TimelineSelector"
            StepTemplate="{StaticResource StepRowTemplate}"
            CrashTemplate="{StaticResource CrashRowTemplate}" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="TitleText" Text="Session" Style="{StaticResource TitleTextBlockStyle}" />
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="10"
                        Padding="8,2"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="StateText"
                            FontSize="12"
                            AutomationProperties.AutomationId="SessionStateText" />
                    </Border>
                </StackPanel>
                <TextBlock
                    x:Name="SubtitleText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="StatusText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    x:Name="HotReloadButton"
                    Content="Hot reload"
                    Click="OnHotReloadClick"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Rebuild the running Flutter app and apply the changes without restarting it"
                    AutomationProperties.AutomationId="SessionHotReloadButton" />
                <Button
                    x:Name="HotRestartButton"
                    Content="Hot restart"
                    Click="OnHotRestartClick"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Restart the running Flutter app and apply code changes to top-level state"
                    AutomationProperties.AutomationId="SessionHotRestartButton" />
                <Button
                    x:Name="MetroReloadButton"
                    Content="Reload"
                    Click="OnMetroReloadClick"
                    Visibility="Collapsed"
                    ToolTipService.ToolTip="Ask Metro to reload the React Native application"
                    AutomationProperties.AutomationId="SessionMetroReloadButton" />
                <Button
                    x:Name="RestartButton"
                    Content="Restart app"
                    Click="OnRestartClick"
                    AutomationProperties.AutomationId="SessionRestartButton" />
                <Button
                    x:Name="CopyStackButton"
                    Content="Copy stack"
                    Click="OnCopyStackClick"
                    AutomationProperties.AutomationId="SessionCopyStackButton" />
                <Button
                    x:Name="PauseLogsButton"
                    Content="Pause logs"
                    Click="OnPauseLogsClick"
                    AutomationProperties.AutomationId="SessionPauseLogsButton" />
                <Button
                    x:Name="StopButton"
                    Content="Stop"
                    Click="OnStopClick"
                    AutomationProperties.AutomationId="SessionStopButton" />
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancelClick"
                    AutomationProperties.AutomationId="SessionCancelButton" />
                <Button
                    x:Name="MirrorButton"
                    Content="Mirror"
                    Click="OnMirrorClick"
                    AutomationProperties.AutomationId="SessionMirrorButton" />
                <StackPanel
                    x:Name="PluginToolbarPanel"
                    Orientation="Horizontal"
                    Spacing="8" />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="PluginPanelsPanel"
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="Collapsed" />

        <InfoBar
            x:Name="ActionBar"
            Grid.Row="2"
            Severity="Success"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="SessionActionBar" />

        <InfoBar
            x:Name="CrashBar"
            Grid.Row="3"
            Severity="Error"
            Title="Crash or ANR detected"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="SessionCrashBar">
            <InfoBar.Content>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="6"
                    Margin="0,0,0,8">
                    <Button
                        Content="Copy stack"
                        Click="OnCopyStackClick"
                        AutomationProperties.AutomationId="SessionCrashCopyButton" />
                    <Button
                        Content="Restart app"
                        Click="OnRestartClick"
                        AutomationProperties.AutomationId="SessionCrashRestartButton" />
                </StackPanel>
            </InfoBar.Content>
            <InfoBar.ActionButton>
                <Button
                    Content="Jump to crash"
                    Click="OnJumpToCrashClick"
                    AutomationProperties.AutomationId="SessionCrashJumpButton" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="Timeline"
                        Style="{StaticResource SectionHeaderStyle}"
                        Margin="16,14,16,6" />
                    <ListView
                        x:Name="StepList"
                        Grid.Row="1"
                        SelectionMode="None"
                        Padding="4,0,4,8"
                        AutomationProperties.AutomationId="SessionTimelineList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplateSelector>
                            <StaticResource ResourceKey="TimelineSelector" />
                        </ListView.ItemTemplateSelector>
                    </ListView>
                    <TextBlock
                        x:Name="NoStepsText"
                        Grid.Row="1"
                        Text="No steps have run yet."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Margin="16,12,16,20"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <TabView
                        x:Name="OutputTabs"
                        IsAddTabButtonVisible="False"
                        CanDragTabs="False"
                        CanReorderTabs="False"
                        AutomationProperties.AutomationId="SessionOutputTabs">
                        <TabViewItem Header="Build" IsClosable="False">
                            <Grid RowSpacing="8" Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        x:Name="BuildErrorSummaryText"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Visibility="Collapsed" />
                                    <ItemsControl
                                        x:Name="BuildErrorList"
                                        AutomationProperties.AutomationId="SessionBuildErrorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Content="{Binding Display}"
                                                    Click="OnBuildErrorClick"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,2"
                                                    ToolTipService.ToolTip="Open the source file at this location" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        x:Name="NoBuildErrorsText"
                                        Text="No compiler errors were reported."
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ListView
                                    x:Name="BuildOutputList"
                                    Grid.Row="1"
                                    SelectionMode="None"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    AutomationProperties.AutomationId="SessionBuildOutput">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding}"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                TextWrapping="NoWrap"
                                                IsTextSelectionEnabled="True" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </TabViewItem>
                        <TabViewItem Header="Logcat" IsClosable="False">
                            <Grid RowSpacing="8" Padding="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.ColumnSpan="2" Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="LevelCombo"
                                            DisplayMemberPath="Label"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.AutomationId="LogLevelFilter" />
                                        <TextBox
                                            x:Name="TagFilterBox"
                                            Grid.Column="1"
                                            PlaceholderText="Tags (comma separated)"
                                            AutomationProperties.AutomationId="LogTagFilter" />
                                        <TextBox
                                            x:Name="PidFilterBox"
                                            Grid.Column="2"
                                            PlaceholderText="PID"
                                            AutomationProperties.AutomationId="LogPidFilter" />
                                        <TextBox
                                            x:Name="PackageFilterBox"
                                            Grid.Column="3"
                                            PlaceholderText="Package"
                                            AutomationProperties.AutomationId="LogPackageFilter" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="TextFilterBox"
                                            PlaceholderText="Text or regular expression"
                                            AutomationProperties.AutomationId="LogTextFilter" />
                                        <CheckBox
                                            x:Name="RegexFilterCheck"
                                            Grid.Column="1"
                                            Content="Regex"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="LogRegexFilter" />
                                        <Button
                                            Grid.Column="2"
                                            Content="Apply filter"
                                            Click="OnApplyFilterClick"
                                            AutomationProperties.AutomationId="ApplyLogFilterButton" />
                                        <Button
                                            Grid.Column="3"
                                            Content="Clear"
                                            Click="OnClearFilterClick"
                                            AutomationProperties.AutomationId="ClearLogFilterButton" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="SavedFilterCombo"
                                            DisplayMemberPath="Name"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="OnSavedFilterChanged"
                                            AutomationProperties.AutomationId="SavedLogFilterCombo" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Save filter"
                                            Click="OnSaveFilterClick"
                                            AutomationProperties.AutomationId="SaveLogFilterButton" />
                                        <Button
                                            Grid.Column="2"
                                            Content="Delete"
                                            Click="OnDeleteFilterClick"
                                            AutomationProperties.AutomationId="DeleteLogFilterButton" />
                                        <TextBlock
                                            x:Name="LogStatusText"
                                            Grid.Column="3"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="LogStatusText" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="SearchBox"
                                            PlaceholderText="Search visible logs"
                                            AutomationProperties.AutomationId="LogSearchBox" />
                                        <Button
                                            Grid.Column="1"
                                            Content="Search"
                                            Click="OnSearchClick"
                                            AutomationProperties.AutomationId="LogSearchButton" />
                                        <Button
                                            Grid.Column="2"
                                            Content="Previous"
                                            Click="OnSearchPreviousClick"
                                            AutomationProperties.AutomationId="LogSearchPreviousButton" />
                                        <Button
                                            Grid.Column="3"
                                            Content="Next"
                                            Click="OnSearchNextClick"
                                            AutomationProperties.AutomationId="LogSearchNextButton" />
                                        <TextBlock
                                            x:Name="SearchCountText"
                                            Grid.Column="4"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            MinWidth="90"
                                            AutomationProperties.AutomationId="LogSearchCount" />
                                    </Grid>
                                    <Expander
                                        Header="Highlight rules"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.AutomationId="LogHighlightExpander">
                                        <ItemsControl x:Name="HighlightList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Content="{Binding Label}"
                                                        IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                        Checked="OnHighlightToggled"
                                                        Unchecked="OnHighlightToggled"
                                                        ToolTipService.ToolTip="{Binding Pattern}"
                                                        AutomationProperties.AutomationId="{Binding AutomationId}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>

                                <ListView
                                    x:Name="LogList"
                                    Grid.Row="1"
                                    SelectionMode="Single"
                                    SelectionChanged="OnLogSelectionChanged"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    AutomationProperties.AutomationId="SessionLogList">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Background="{Binding Background}"
                                                Padding="2,1">
                                                <TextBlock
                                                    Text="{Binding Text}"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    TextWrapping="NoWrap"
                                                    Foreground="{Binding Foreground}"
                                                    FontWeight="{Binding Weight}"
                                                    IsTextSelectionEnabled="True" />
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Border
                                    x:Name="LogDetailPanel"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="420"
                                    Margin="8,0,0,0"
                                    Padding="8"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    AutomationProperties.AutomationId="SessionLogDetailPanel">
                                    <ContentControl x:Name="LogRendererHost" />
                                </Border>

                                <TextBlock
                                    x:Name="NoLogsText"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="No log lines yet. Attach logcat or run the app."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="16,12,16,20"
                                    Visibility="Collapsed" />
                            </Grid>
                        </TabViewItem>
                    </TabView>

                    <StackPanel
                        x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        MaxWidth="360"
                        Padding="24"
                        Visibility="Collapsed">
                        <TextBlock
                            Text="No session selected"
                            Style="{StaticResource SectionHeaderStyle}"
                            TextAlignment="Center" />
                        <TextBlock
                            Text="Run a project or open a session from History to see its timeline, build output, and logs."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Content="Open projects"
                            Click="OnOpenProjectsClick"
                            HorizontalAlignment="Center"
                            AutomationProperties.AutomationId="SessionOpenProjectsButton" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
