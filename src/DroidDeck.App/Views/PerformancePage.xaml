<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DroidDeck.App.Controls">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Text="{StaticResource Loc.page.performance.title}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="Sample launch time, FPS and jank, CPU, memory, and battery for a running application. Charts update live and every sample can be exported as CSV."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Content="Refresh devices"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="RefreshPerformanceDevicesButton" />
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancelClick"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="CancelPerformanceButton" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ActionBar"
                Severity="Success"
                IsOpen="False"
                IsClosable="True"
                AutomationProperties.AutomationId="PerformanceActionBar" />
            <InfoBar
                x:Name="GuidanceBar"
                Severity="Informational"
                Title="Next step"
                IsOpen="False"
                IsClosable="False"
                AutomationProperties.AutomationId="PerformanceGuidanceBar" />
            <ProgressBar
                x:Name="BusyProgress"
                IsIndeterminate="True"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="PerformanceProgress" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Name="DeviceCombo"
                    Header="Device"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnDeviceSelectionChanged"
                    AutomationProperties.AutomationId="PerformanceDeviceCombo" />
                <ComboBox
                    x:Name="AppCombo"
                    Grid.Column="1"
                    Header="Application"
                    DisplayMemberPath="Display"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnAppSelectionChanged"
                    AutomationProperties.AutomationId="PerformanceAppCombo" />
                <TextBox
                    x:Name="PackageBox"
                    Grid.Column="2"
                    Header="Package name"
                    PlaceholderText="com.example.app"
                    AutomationProperties.AutomationId="PerformancePackageBox" />
                <NumberBox
                    x:Name="IntervalBox"
                    Grid.Column="3"
                    Header="Interval (ms)"
                    Minimum="250"
                    Maximum="60000"
                    SmallChange="250"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnIntervalChanged"
                    AutomationProperties.AutomationId="PerformanceIntervalBox" />

                <Button
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="Reload applications"
                    Click="OnReloadAppsClick"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="ReloadPerformanceAppsButton" />
                <TextBlock
                    x:Name="LaunchTimeText"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No run launch time yet."
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="PerformanceLaunchTime" />
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Right">
                    <Button
                        x:Name="StartButton"
                        Content="Start"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnStartSamplingClick"
                        AutomationProperties.AutomationId="StartPerformanceSamplingButton" />
                    <Button
                        x:Name="StopButton"
                        Content="Stop"
                        Click="OnStopSamplingClick"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="StopPerformanceSamplingButton" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="ExportButton"
                        Content="Export CSV"
                        Click="OnExportCsvClick"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="ExportPerformanceCsvButton" />
                    <Button
                        x:Name="ClearButton"
                        Content="Clear samples"
                        Click="OnClearSamplesClick"
                        IsEnabled="False"
                        AutomationProperties.AutomationId="ClearPerformanceSamplesButton" />
                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No samples yet."
                        AutomationProperties.AutomationId="PerformanceStatus" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="CPU" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock
                                x:Name="CpuValueText"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="--"
                                AutomationProperties.AutomationId="PerformanceCpuValue" />
                        </Grid>
                        <controls:PerformanceSparkline
                            x:Name="CpuChart"
                            Height="96"
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Memory" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock
                                x:Name="MemoryValueText"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="--"
                                AutomationProperties.AutomationId="PerformanceMemoryValue" />
                        </Grid>
                        <controls:PerformanceSparkline
                            x:Name="MemoryChart"
                            Height="96"
                            Stroke="{ThemeResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="FPS" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock
                                x:Name="FpsValueText"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="--"
                                AutomationProperties.AutomationId="PerformanceFpsValue" />
                        </Grid>
                        <controls:PerformanceSparkline
                            x:Name="FpsChart"
                            Height="96"
                            Stroke="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Jank" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock
                                x:Name="JankValueText"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="--"
                                AutomationProperties.AutomationId="PerformanceJankValue" />
                        </Grid>
                        <controls:PerformanceSparkline
                            x:Name="JankChart"
                            Height="96"
                            Stroke="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Battery" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock
                                x:Name="BatteryValueText"
                                HorizontalAlignment="Right"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="--"
                                AutomationProperties.AutomationId="PerformanceBatteryValue" />
                        </Grid>
                        <controls:PerformanceSparkline
                            x:Name="BatteryChart"
                            Height="96"
                            Stroke="{ThemeResource SystemFillColorAttentionBrush}" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource CardBorderStyle}">
                    <ContentControl x:Name="ChartRendererHost" />
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Session summary" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="SummaryText"
                            FontSize="12"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            Text="Start sampling to build a summary."
                            AutomationProperties.AutomationId="PerformanceSummary" />
                        <TextBlock
                            x:Name="WarningText"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="PerformanceWarnings" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <Expander
                        Header="One-shot diagnostics"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock
                                Text="Read a single metric and inspect the exact command and raw output."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="CPU" Click="OnCpuClick" AutomationProperties.AutomationId="RunCpuButton" />
                                <Button Content="Memory" Click="OnMemoryClick" AutomationProperties.AutomationId="RunMemoryButton" />
                                <Button Content="Frame stats" Click="OnFrameStatsClick" AutomationProperties.AutomationId="RunFrameStatsButton" />
                                <Button Content="Latency" Click="OnLatencyClick" AutomationProperties.AutomationId="RunLatencyButton" />
                                <Button Content="Battery" Click="OnBatteryClick" AutomationProperties.AutomationId="RunBatteryButton" />
                            </StackPanel>
                            <TextBlock
                                x:Name="MetricTitleText"
                                Text="No measurement yet"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="MetricSummaryText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                            <TextBlock Text="Command" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock
                                x:Name="CommandText"
                                FontFamily="Consolas"
                                FontSize="11"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                AutomationProperties.AutomationId="PerformanceCommand" />
                            <TextBox
                                x:Name="OutputBox"
                                Height="180"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="NoWrap"
                                FontFamily="Consolas"
                                FontSize="11"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                AutomationProperties.AutomationId="PerformanceOutput" />
                        </StackPanel>
                    </Expander>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
