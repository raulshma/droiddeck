<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Catalog" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Browse plugin catalogs you add. Browsing never installs or trusts a plugin."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Content="Add source"
                    Click="OnAddSourceClick"
                    AutomationProperties.AutomationId="CatalogAddSourceButton" />
                <Button
                    x:Name="RefreshButton"
                    Content="Refresh"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="CatalogRefreshButton" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ActionBar"
            Grid.Row="1"
            Severity="Success"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="CatalogActionBar" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="Sources" Style="{StaticResource SectionHeaderStyle}" />
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        x:Name="SourceList"
                        AutomationProperties.AutomationId="CatalogSourceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="{Binding Target}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            Foreground="{Binding StatusBrush}" />
                                        <TextBlock
                                            Text="{Binding Error}"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                        <Button
                                            Content="{Binding ToggleLabel}"
                                            Click="OnToggleSourceClick"
                                            AutomationProperties.AutomationId="{Binding ToggleId}" />
                                        <Button
                                            Content="Remove"
                                            Click="OnRemoveSourceClick"
                                            AutomationProperties.AutomationId="{Binding RemoveId}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock
                    x:Name="NoSourcesText"
                    Text="No catalog sources yet. Add an HTTPS URL or a local catalog file."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="8" ColumnSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Search name, publisher, id, or tag"
                    TextChanged="OnSearchTextChanged"
                    AutomationProperties.AutomationId="CatalogSearchBox" />
                <ComboBox
                    x:Name="SourceFilter"
                    Grid.Column="1"
                    MinWidth="160"
                    SelectionChanged="OnFilterChanged"
                    AutomationProperties.AutomationId="CatalogSourceFilter" />
                <ComboBox
                    x:Name="TagFilter"
                    Grid.Column="2"
                    MinWidth="140"
                    SelectionChanged="OnFilterChanged"
                    AutomationProperties.AutomationId="CatalogTagFilter" />
                <CheckBox
                    x:Name="PrereleaseCheck"
                    Grid.Column="3"
                    Content="Include pre-release"
                    VerticalAlignment="Center"
                    Checked="OnFilterChanged"
                    Unchecked="OnFilterChanged"
                    AutomationProperties.AutomationId="CatalogPrereleaseCheck" />
                <TextBlock
                    x:Name="ResultsText"
                    Grid.Row="1"
                    Grid.ColumnSpan="4"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    AutomationProperties.AutomationId="CatalogResultsText" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="Available plugins"
                    Style="{StaticResource SectionHeaderStyle}"
                    Margin="16,14,16,6" />
                <ListView
                    x:Name="CatalogList"
                    Grid.Row="1"
                    SelectionMode="None"
                    Padding="4,0,4,8"
                    AutomationProperties.AutomationId="CatalogList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="4,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="12,10"
                                RowSpacing="4"
                                AutomationProperties.AutomationId="{Binding EntryId}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding VersionLabel}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{Binding Publisher}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Text="{Binding Summary}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        Text="{Binding CompatibilityBadge}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding CompatibilityBrush}" />
                                    <TextBlock
                                        Text="{Binding CompatibilityLabel}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="3"
                                    Text="{Binding Changelog}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel
                                    Grid.Row="4"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    HorizontalAlignment="Right">
                                    <TextBlock
                                        Text="{Binding Tags}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Text="{Binding SourceLabel}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    Text="No catalog plugins to show yet. Add a source, then choose Refresh."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    Margin="16,12,16,20"
                    AutomationProperties.AutomationId="CatalogEmptyText" />
            </Grid>
        </Border>
    </Grid>
</Page>
