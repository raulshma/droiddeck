<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.ExtensionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Extensions" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Built-in commands and installed plugins. Plugin issues are listed below."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Content="Open plugins folder"
                    Click="OnOpenPluginsFolderClick"
                    AutomationProperties.AutomationId="OpenPluginsFolderButton" />
                <Button
                    Content="Copy diagnostics"
                    Click="OnCopyDiagnosticsClick"
                    AutomationProperties.AutomationId="ExtensionsCopyDiagnosticsButton" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ActionBar"
            Grid.Row="1"
            Severity="Success"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="ExtensionsActionBar" />

        <InfoBar
            x:Name="RestartNotice"
            Grid.Row="2"
            Severity="Warning"
            Title="Restart required"
            Message="Enable and disable take full effect after DroidDeck restarts. Unloading a disabled plugin requires a restart."
            IsOpen="False"
            IsClosable="False"
            AutomationProperties.AutomationId="PluginRestartNotice" />

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Plugin status" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="PluginsStatusText"
                            Style="{StaticResource FieldValueStyle}"
                            AutomationProperties.AutomationId="PluginsStatusText" />
                        <TextBlock
                            x:Name="BuiltInSummaryText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="BuiltInExtensionsSummary" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Built-in commands" Style="{StaticResource SectionHeaderStyle}" />
                        <ItemsControl
                            x:Name="CommandList"
                            AutomationProperties.AutomationId="CommandList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Subtitle}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="Run"
                                            VerticalAlignment="Center"
                                            Click="OnRunCommandClick"
                                            AutomationProperties.AutomationId="{Binding RunId}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="NoCommandsText"
                            Text="No commands are registered."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="Renderers"
                                Style="{StaticResource SectionHeaderStyle}"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Content="Reset view choices"
                                Click="OnResetRendererChoicesClick"
                                AutomationProperties.AutomationId="ResetRendererChoicesButton" />
                        </Grid>
                        <TextBlock
                            Text="Every View as surface lists these renderers. A renderer that fails three times in a row is disabled for the rest of the session, and the built-in view is used instead. Reset view choices clears the saved View as selection for each item type."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <ItemsControl
                            x:Name="RendererList"
                            AutomationProperties.AutomationId="RendererList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,4" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Subtitle}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Health}"
                                            FontSize="12"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="NoRenderersText"
                            Text="No renderers are registered yet."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Text="Installed plugins"
                            Style="{StaticResource SectionHeaderStyle}"
                            Margin="16,14,16,6" />
                        <ListView
                            x:Name="PluginList"
                            Grid.Row="1"
                            SelectionMode="None"
                            Padding="4,0,4,8"
                            AutomationProperties.AutomationId="PluginList">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="4,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Subtitle}"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding Reason}"
                                                FontSize="12"
                                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock
                                                Text="{Binding Health}"
                                                FontSize="12"
                                                Foreground="{Binding HealthBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasHealth, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Status}"
                                            FontSize="12"
                                            Foreground="{Binding StatusBrush}"
                                            VerticalAlignment="Top" />
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Top">
                                            <Button
                                                Content="Enable"
                                                IsEnabled="{Binding CanEnable}"
                                                Visibility="{Binding CanEnable, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnEnablePluginClick"
                                                AutomationProperties.AutomationId="{Binding EnableId}" />
                                            <Button
                                                Content="Trust"
                                                Visibility="{Binding CanTrust, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnTrustPluginClick"
                                                AutomationProperties.AutomationId="{Binding TrustId}" />
                                            <Button
                                                Content="Disable"
                                                Visibility="{Binding CanDisable, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnDisablePluginClick"
                                                AutomationProperties.AutomationId="{Binding DisableId}" />
                                            <Button
                                                Content="{Binding UpdateLabel}"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnUpdatePluginClick"
                                                AutomationProperties.AutomationId="{Binding UpdateId}" />
                                            <Button
                                                Content="{Binding RollbackLabel}"
                                                Visibility="{Binding CanRollback, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnRollbackPluginClick"
                                                AutomationProperties.AutomationId="{Binding RollbackId}" />
                                            <Button
                                                Content="Folder"
                                                Click="OnOpenPluginFolderClick"
                                                AutomationProperties.AutomationId="{Binding FolderId}" />
                                            <Button
                                                Content="Logs"
                                                Click="OnViewPluginLogsClick"
                                                AutomationProperties.AutomationId="{Binding LogsId}" />
                                            <Button
                                                Content="Settings"
                                                Click="OnPluginSettingsClick"
                                                AutomationProperties.AutomationId="{Binding SettingsId}" />
                                            <Button
                                                Content="Uninstall"
                                                Click="OnUninstallPluginClick"
                                                AutomationProperties.AutomationId="{Binding UninstallId}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptyText"
                            Grid.Row="1"
                            Text="No third-party plugins are installed."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            Margin="16,12,16,20"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
