<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DroidDeck.App.Views.ScanProjectsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Scan for projects"
    PrimaryButtonText="Add selected"
    SecondaryButtonText="Add all"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="10" MinWidth="560">
        <TextBlock
            Text="Nested Gradle, Flutter, and Kotlin Multiplatform projects are detected without invoking Gradle or Flutter. APK folders are offered as APK-only projects."
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />
        <Grid ColumnSpacing="10" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Depth" Style="{StaticResource FieldLabelStyle}" />
                <NumberBox
                    x:Name="DepthBox"
                    Width="100"
                    Minimum="0"
                    Maximum="12"
                    SpinButtonPlacementMode="Compact"
                    AutomationProperties.AutomationId="ScanDepthBox" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Timeout (s)" Style="{StaticResource FieldLabelStyle}" />
                <NumberBox
                    x:Name="TimeoutBox"
                    Width="100"
                    Minimum="1"
                    Maximum="60"
                    SpinButtonPlacementMode="Compact"
                    AutomationProperties.AutomationId="ScanTimeoutBox" />
            </StackPanel>
            <CheckBox
                x:Name="NestedCheck"
                Grid.Column="2"
                Content="Detect nested projects"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="ScanNestedCheck" />
            <StackPanel Grid.Column="3" Spacing="4">
                <TextBlock Text="Ignored folders (comma separated)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox x:Name="IgnoreBox" AutomationProperties.AutomationId="ScanIgnoreBox" />
            </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="RescanButton"
                Content="Rescan"
                Click="OnRescanClick"
                AutomationProperties.AutomationId="RescanProjectsButton" />
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock
            x:Name="ErrorText"
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <ListView
            x:Name="CandidateList"
            MaxHeight="320"
            SelectionMode="None"
            AutomationProperties.AutomationId="ScanCandidateList">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsEnabled="{Binding CanSelect}"
                            VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding Badge}"
                                    FontSize="11"
                                    Foreground="{Binding BadgeBrush}" />
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Detail}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
