<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.MirrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Text="{StaticResource Loc.page.mirror.title}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="Start scrcpy docked over the pane or in its own window, capture screenshots, record the screen, and send device keys. Docked mirrors stop when you leave this page; external windows stay open."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Content="Refresh devices"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="RefreshMirrorDevicesButton" />
                <Button
                    Content="Mirror settings"
                    Click="OnOpenSettingsClick"
                    AutomationProperties.AutomationId="OpenMirrorSettingsButton" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="AvailabilityBar"
                Severity="Warning"
                Title="Mirroring is not available"
                IsOpen="False"
                IsClosable="False"
                AutomationProperties.AutomationId="MirrorAvailabilityBar" />
            <InfoBar
                x:Name="ActionBar"
                Severity="Success"
                IsOpen="False"
                IsClosable="True"
                AutomationProperties.AutomationId="MirrorActionBar" />
            <InfoBar
                x:Name="GuidanceBar"
                Severity="Informational"
                Title="Next step"
                IsOpen="False"
                IsClosable="False"
                AutomationProperties.AutomationId="MirrorGuidanceBar" />
            <ProgressBar
                x:Name="BusyProgress"
                IsIndeterminate="True"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="MirrorProgress" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="Mirror pane"
                        Style="{StaticResource SectionHeaderStyle}"
                        Margin="16,14,16,6" />
                    <Border
                        x:Name="MirrorPane"
                        Grid.Row="1"
                        Margin="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        SizeChanged="OnMirrorPaneSizeChanged"
                        AutomationProperties.AutomationId="MirrorPane">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            MaxWidth="360"
                            Padding="16">
                            <FontIcon
                                Glyph="&#xE7F4;"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                x:Name="MirrorPlaceholderTitle"
                                Text="No mirror running"
                                Style="{StaticResource SectionHeaderStyle}"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="MirrorPlaceholderText"
                                Text="Select a device and start a docked mirror. The scrcpy window is positioned over this pane."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <ScrollViewer Padding="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Device" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox
                            x:Name="DeviceCombo"
                            Header="Device"
                            DisplayMemberPath="DisplayName"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnDeviceSelectionChanged"
                            AutomationProperties.AutomationId="MirrorDeviceCombo" />
                        <ComboBox
                            x:Name="HostingCombo"
                            Header="Hosting"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnHostingChanged"
                            AutomationProperties.AutomationId="MirrorHostingCombo" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="StartButton"
                                Content="Start"
                                Click="OnStartClick"
                                AutomationProperties.AutomationId="StartMirrorButton" />
                            <Button
                                x:Name="StopButton"
                                Content="Stop"
                                Click="OnStopClick"
                                AutomationProperties.AutomationId="StopMirrorButton" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="PopOutButton"
                                Content="Pop out"
                                Click="OnPopOutClick"
                                AutomationProperties.AutomationId="PopOutMirrorButton" />
                            <Button
                                x:Name="FocusButton"
                                Content="Focus window"
                                Click="OnFocusClick"
                                AutomationProperties.AutomationId="FocusMirrorButton" />
                        </StackPanel>
                        <Button
                            x:Name="FullscreenButton"
                            Content="Toggle fullscreen"
                            Click="OnFullscreenClick"
                            AutomationProperties.AutomationId="FullscreenMirrorButton" />

                        <TextBlock Text="Capture" Style="{StaticResource SectionHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ScreenshotButton"
                                Content="Screenshot"
                                Click="OnScreenshotClick"
                                AutomationProperties.AutomationId="ScreenshotButton" />
                            <Button
                                x:Name="RecordButton"
                                Content="Record"
                                Click="OnStartRecordingClick"
                                AutomationProperties.AutomationId="StartRecordingButton" />
                            <Button
                                x:Name="StopRecordButton"
                                Content="Stop recording"
                                Click="OnStopRecordingClick"
                                AutomationProperties.AutomationId="StopRecordingButton" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="OpenLastPathButton"
                                Content="Open file"
                                Click="OnOpenLastPathClick"
                                AutomationProperties.AutomationId="OpenMirrorFileButton" />
                            <Button
                                x:Name="OpenCaptureFolderButton"
                                Content="Open folder"
                                Click="OnOpenCaptureFolderClick"
                                AutomationProperties.AutomationId="OpenMirrorFolderButton" />
                        </StackPanel>
                        <TextBlock
                            x:Name="CapturePathText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            AutomationProperties.AutomationId="MirrorCapturePath" />

                        <TextBlock Text="Device keys" Style="{StaticResource SectionHeaderStyle}" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" Grid.Column="0" Content="Back" Tag="Back" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="0" Grid.Column="1" Content="Home" Tag="Home" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Recents" Tag="Recents" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="0" Content="Vol +" Tag="VolumeUp" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="1" Content="Vol −" Tag="VolumeDown" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Power" Tag="Power" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="2" Grid.Column="0" Content="Wake" Tag="Wake" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                            <Button Grid.Row="2" Grid.Column="1" Content="Menu" Tag="Menu" Click="OnKeyClick" HorizontalAlignment="Stretch" />
                        </Grid>

                        <TextBlock Text="Session" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            x:Name="SessionStateText"
                            Text="No mirror running."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="MirrorSessionState" />
                        <Expander Header="Exact scrcpy command" HorizontalAlignment="Stretch">
                            <TextBlock
                                x:Name="SessionCommandText"
                                FontFamily="Consolas"
                                FontSize="12"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
