<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="Activity" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Application log entries for this session, newest first."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ComboBox
                    x:Name="LevelFilter"
                    MinWidth="130"
                    SelectionChanged="OnLevelFilterChanged"
                    AutomationProperties.AutomationId="ActivityLevelFilter" />
                <Button
                    Content="Refresh"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="ActivityRefreshButton" />
                <Button
                    Content="Copy recent"
                    Click="OnCopyClick"
                    AutomationProperties.AutomationId="ActivityCopyButton" />
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="ActionBar"
            Grid.Row="1"
            Severity="Success"
            IsOpen="False"
            IsClosable="True"
            AutomationProperties.AutomationId="ActivityActionBar" />

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="SummaryText"
                    Text="No log entries yet."
                    Style="{StaticResource SectionHeaderStyle}"
                    Margin="16,14,16,6" />
                <ListView
                    x:Name="ActivityList"
                    Grid.Row="1"
                    SelectionMode="None"
                    Padding="4,0,4,4"
                    AutomationProperties.AutomationId="ActivityList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="4,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{Binding Time}"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    VerticalAlignment="Top" />
                                <Border
                                    Grid.Column="1"
                                    Background="{Binding LevelBackground}"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        Text="{Binding Level}"
                                        Foreground="{Binding LevelBrush}"
                                        FontSize="11" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding Category}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Message}"
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    ToolTipService.ToolTip="{Binding Tooltip}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="EmptyText"
                    Grid.Row="1"
                    Text="No activity matches the current filter."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
