<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DroidDeck.App.Views.ApkInstallDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Install APK"
    PrimaryButtonText="Install &amp; launch"
    SecondaryButtonText="Install only"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick"
    AutomationProperties.AutomationId="ApkInstallDialog">

    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel MinWidth="600" Spacing="12">
            <InfoBar
                x:Name="ErrorBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Error"
                AutomationProperties.AutomationId="ApkInstallErrorBar" />

            <Border
                x:Name="ErrorCard"
                Style="{StaticResource CardBorderStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="ErrorCardTitle"
                        Text="DroidDeck could not read this APK"
                        Style="{StaticResource SectionHeaderStyle}" />
                    <ItemsControl x:Name="ErrorList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="GuidanceHeader"
                        Text="How to fix it"
                        FontSize="12"
                        FontWeight="SemiBold" />
                    <ItemsControl x:Name="GuidanceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ComboBox
                x:Name="PlanCombo"
                Header="APK set"
                DisplayMemberPath="Title"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnPlanChanged"
                AutomationProperties.AutomationId="ApkInstallPlanCombo" />

            <Border
                x:Name="PlanCard"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Name="PackageText"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        AutomationProperties.AutomationId="ApkInstallPackageText" />
                    <TextBlock
                        x:Name="VersionText"
                        FontSize="13"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SdkText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="AbiText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="FilesText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ActivityText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="DeviceSection"
                Spacing="6">
                <Grid>
                    <TextBlock Text="Install on" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock
                        x:Name="DeviceHint"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListView
                    x:Name="DeviceList"
                    MaxHeight="250"
                    SelectionMode="None"
                    AutomationProperties.AutomationId="ApkInstallDeviceList">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="2,4" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    IsEnabled="{Binding CanInstall}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detail}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding StateLabel}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Text="Ready devices are selected by default. Devices that are offline or unauthorized are skipped."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
