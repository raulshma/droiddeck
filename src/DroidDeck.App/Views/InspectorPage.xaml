<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.InspectorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="UI inspector" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Dump the current UI hierarchy with uiautomator, inspect node bounds and resources, and filter large trees. The exact commands are shown before execution."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Content="Refresh devices"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="RefreshInspectorDevicesButton" />
                <Button
                    x:Name="CancelButton"
                    Content="Cancel"
                    Click="OnCancelClick"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="CancelInspectorButton" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ActionBar"
                Severity="Success"
                IsOpen="False"
                IsClosable="True"
                AutomationProperties.AutomationId="InspectorActionBar" />
            <InfoBar
                x:Name="GuidanceBar"
                Severity="Informational"
                Title="Next step"
                IsOpen="False"
                IsClosable="False"
                AutomationProperties.AutomationId="InspectorGuidanceBar" />
            <ProgressBar
                x:Name="BusyProgress"
                IsIndeterminate="True"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="InspectorProgress" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Name="DeviceCombo"
                    Header="Device"
                    DisplayMemberPath="DisplayName"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnDeviceSelectionChanged"
                    AutomationProperties.AutomationId="InspectorDeviceCombo" />
                <Button
                    x:Name="DumpButton"
                    Grid.Column="1"
                    Content="Dump hierarchy"
                    Click="OnDumpClick"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="DumpHierarchyButton" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="2"
                    Header="Filter nodes"
                    PlaceholderText="text, resource id, class, or package"
                    TextChanged="OnSearchChanged"
                    AutomationProperties.AutomationId="InspectorSearchBox" />
                <TextBlock
                    x:Name="NodeCountText"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No hierarchy loaded."
                    AutomationProperties.AutomationId="InspectorNodeCount" />
                <TextBlock
                    x:Name="CommandText"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    FontFamily="Consolas"
                    FontSize="11"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True"
                    AutomationProperties.AutomationId="InspectorCommands" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="Nodes"
                        Style="{StaticResource SectionHeaderStyle}"
                        Margin="16,14,16,6" />
                    <ListView
                        x:Name="NodeList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnNodeSelectionChanged"
                        Padding="4,0,4,8"
                        AutomationProperties.AutomationId="InspectorNodeList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="2,1" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="{Binding Indent}" Padding="6,4" Spacing="1">
                                    <TextBlock
                                        Text="{Binding Display}"
                                        FontSize="13"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <TextBlock
                                        Text="{Binding Detail}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="NodeEmptyText"
                        Grid.Row="1"
                        Text="Dump the hierarchy to list the current screen's views."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxWidth="340" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Selected node" Style="{StaticResource SectionHeaderStyle}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="NodeDetailsText"
                            Text="Select a node to see its bounds, resource id, and state."
                            FontSize="13"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True"
                            AutomationProperties.AutomationId="InspectorNodeDetails" />
                    </ScrollViewer>
                    <Expander Grid.Row="2" Header="Raw hierarchy XML" HorizontalAlignment="Stretch">
                        <TextBox
                            x:Name="RawXmlBox"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            FontFamily="Consolas"
                            FontSize="11"
                            Height="220"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="InspectorRawXml" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
