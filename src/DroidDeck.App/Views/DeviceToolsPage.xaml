<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.DeviceToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Text="{StaticResource Loc.page.device-tools.title}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="Apps, permissions, adb shell, ports, files, intents, broadcasts, and plugin contributions. Every action reports the exact adb command."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ComboBox
                    x:Name="DeviceCombo"
                    MinWidth="260"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="OnDeviceSelectionChanged"
                    AutomationProperties.AutomationId="ToolboxDeviceCombo" />
                <Button
                    Content="Refresh"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="ToolboxRefreshButton" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="AvailabilityBar"
                Severity="Warning"
                Title="No usable device"
                IsOpen="False"
                IsClosable="False"
                AutomationProperties.AutomationId="ToolboxAvailabilityBar" />
            <ProgressBar
                x:Name="BusyProgress"
                IsIndeterminate="True"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="ToolboxProgress" />
        </StackPanel>

        <TabView
            x:Name="MainTabs"
            Grid.Row="2"
            IsAddTabButtonVisible="False"
            CanDragTabs="False"
            CanReorderTabs="False"
            AutomationProperties.AutomationId="ToolboxTabs">
            <TabViewItem Header="Apps" IsClosable="False">
                <Grid Padding="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="Installed apps"
                                Style="{StaticResource SectionHeaderStyle}"
                                VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="AppFilterCombo"
                                MinWidth="130"
                                SelectionChanged="OnAppFilterChanged"
                                AutomationProperties.AutomationId="AppFilterCombo" />
                            <Button
                                Content="Reload apps"
                                Click="OnLoadAppsClick"
                                AutomationProperties.AutomationId="ReloadAppsButton" />
                        </StackPanel>
                        <ListView
                            x:Name="AppList"
                            Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnAppSelectionChanged"
                            AutomationProperties.AutomationId="ToolboxAppList">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding PackageName}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding KindLabel}"
                                            FontSize="11"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="AppEmptyText"
                            Grid.Row="1"
                            Text="No applications were found. Check that the device is authorized and try another filter."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="320" />
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="Selected app" Style="{StaticResource SectionHeaderStyle}" />
                                <TextBlock
                                    x:Name="AppSelectedName"
                                    Text="Select an app"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="AppSelectedPackage"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                                <TextBlock
                                    x:Name="AppSelectedDetails"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="AppInfoButton"
                                    Content="Open app info"
                                    Click="OnOpenAppInfoClick"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="OpenAppInfoButton" />
                                <Button
                                    x:Name="LoadPermissionsButton"
                                    Content="Show permissions"
                                    Click="OnShowPermissionsClick"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="ShowPermissionsButton" />
                                <TextBlock Text="Destructive actions" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
                                <Button
                                    x:Name="ForceStopButton"
                                    Content="Force stop"
                                    Click="OnForceStopClick"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="ForceStopButton" />
                                <Button
                                    x:Name="ClearDataButton"
                                    Content="Clear app data"
                                    Click="OnClearDataClick"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="ClearAppDataButton" />
                                <Button
                                    x:Name="UninstallButton"
                                    Content="Uninstall"
                                    Click="OnUninstallClick"
                                    IsEnabled="False"
                                    AutomationProperties.AutomationId="UninstallAppButton" />
                                <TextBlock
                                    Text="Uninstall, clear data, and force stop ask for confirmation first."
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Permissions" IsClosable="False">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            Text="Runtime permissions"
                            Style="{StaticResource SectionHeaderStyle}"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="PermissionAppCombo"
                            MinWidth="280"
                            DisplayMemberPath="Display"
                            SelectionChanged="OnPermissionAppChanged"
                            AutomationProperties.AutomationId="PermissionAppCombo" />
                        <Button
                            Content="Reload"
                            Click="OnReloadPermissionsClick"
                            AutomationProperties.AutomationId="ReloadPermissionsButton" />
                    </StackPanel>
                    <ListView
                        x:Name="PermissionList"
                        Grid.Row="1"
                        SelectionMode="None"
                        AutomationProperties.AutomationId="PermissionList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding GrantLabel}"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Content="Grant"
                                            Click="OnGrantPermissionClick"
                                            IsEnabled="{Binding IsGranted, Converter={StaticResource BoolNegationConverter}}"
                                            AutomationProperties.AutomationId="GrantPermissionButton" />
                                        <Button
                                            Content="Revoke"
                                            Click="OnRevokePermissionClick"
                                            IsEnabled="{Binding IsGranted}"
                                            AutomationProperties.AutomationId="RevokePermissionButton" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="PermissionEmptyText"
                        Grid.Row="1"
                        Text="Select an app to list its runtime permissions."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="PermissionHintText"
                        Grid.Row="2"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Shell" IsClosable="False">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox
                        x:Name="ShellCommandBox"
                        Header="adb shell command"
                        PlaceholderText="Getprop ro.product.model"
                        FontFamily="Consolas"
                        AutomationProperties.AutomationId="ShellCommandBox" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ShellRunButton"
                            Content="Run"
                            Click="OnRunShellClick"
                            AutomationProperties.AutomationId="RunShellButton" />
                        <Button
                            x:Name="ShellCancelButton"
                            Content="Cancel"
                            Click="OnCancelShellClick"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="CancelShellButton" />
                        <Button
                            Content="Clear history"
                            Click="OnClearShellHistoryClick"
                            AutomationProperties.AutomationId="ClearShellHistoryButton" />
                    </StackPanel>
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ShellOutput"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Consolas"
                            FontSize="12"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            AutomationProperties.AutomationId="ShellOutput" />
                        <Grid Grid.Column="1" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="History" Style="{StaticResource SectionHeaderStyle}" />
                            <ListView
                                x:Name="ShellHistoryList"
                                Grid.Row="1"
                                SelectionMode="Single"
                                SelectionChanged="OnShellHistorySelectionChanged"
                                AutomationProperties.AutomationId="ShellHistoryList">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,4" Spacing="1">
                                            <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding Detail}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                    <TextBlock
                        x:Name="ShellCommandLineText"
                        Grid.Row="3"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.AutomationId="ShellCommandLineText" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Ports" IsClosable="False">
                <Grid Padding="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Port mappings" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            <ComboBox
                                x:Name="PortDirectionCombo"
                                MinWidth="120"
                                SelectionChanged="OnPortDirectionChanged"
                                AutomationProperties.AutomationId="PortDirectionCombo">
                                <ComboBoxItem Content="Forward" />
                                <ComboBoxItem Content="Reverse" />
                            </ComboBox>
                            <Button Content="Refresh" Click="OnRefreshPortsClick" AutomationProperties.AutomationId="RefreshPortsButton" />
                        </StackPanel>
                        <ListView
                            x:Name="PortList"
                            Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnPortSelectionChanged"
                            AutomationProperties.AutomationId="PortList">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="6,4" Spacing="1">
                                        <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="13" />
                                        <TextBlock
                                            Text="{Binding DirectionLabel}"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="PortEmptyText"
                            Grid.Row="1"
                            Text="No port mappings in this direction."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Add a mapping" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox
                                x:Name="PortLocalBox"
                                Header="Local"
                                PlaceholderText="tcp:8080"
                                AutomationProperties.AutomationId="PortLocalBox" />
                            <TextBox
                                x:Name="PortRemoteBox"
                                Header="Remote"
                                PlaceholderText="tcp:8080"
                                AutomationProperties.AutomationId="PortRemoteBox" />
                            <Button
                                Content="Add"
                                Click="OnAddPortClick"
                                AutomationProperties.AutomationId="AddPortButton" />
                            <Button
                                x:Name="RemovePortButton"
                                Content="Remove selected"
                                Click="OnRemovePortClick"
                                IsEnabled="False"
                                AutomationProperties.AutomationId="RemovePortButton" />
                            <Button
                                Content="Remove all in this direction"
                                Click="OnRemoveAllPortsClick"
                                AutomationProperties.AutomationId="RemoveAllPortsButton" />
                            <TextBlock
                                Text="Removing every mapping requires confirmation."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Files" IsClosable="False">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="FilePathBox"
                            Header="Device path"
                            MinWidth="320"
                            Text="/sdcard"
                            AutomationProperties.AutomationId="FilePathBox" />
                        <Button Content="Go" Click="OnGoToPathClick" VerticalAlignment="Bottom" AutomationProperties.AutomationId="GoToPathButton" />
                        <Button Content="Up" Click="OnGoUpClick" VerticalAlignment="Bottom" AutomationProperties.AutomationId="GoUpButton" />
                        <Button
                            x:Name="PushFileButton"
                            Content="Push file"
                            Click="OnPushFileClick"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="PushFileButton" />
                        <Button
                            x:Name="PullFileButton"
                            Content="Pull selected"
                            Click="OnPullFileClick"
                            VerticalAlignment="Bottom"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="PullFileButton" />
                        <Button
                            x:Name="DeleteFileButton"
                            Content="Delete selected"
                            Click="OnDeleteFileClick"
                            VerticalAlignment="Bottom"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="DeleteFileButton" />
                        <Button
                            x:Name="CancelTransferButton"
                            Content="Cancel transfer"
                            Click="OnCancelTransferClick"
                            VerticalAlignment="Bottom"
                            IsEnabled="False"
                            AutomationProperties.AutomationId="CancelFileTransferButton" />
                    </StackPanel>
                    <ListView
                        x:Name="FileList"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnFileSelectionChanged"
                        AutomationProperties.AutomationId="FileList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding SizeLabel}"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        VerticalAlignment="Center" />
                                    <Button
                                        Grid.Column="3"
                                        Content="Open"
                                        Click="OnOpenFileEntryClick"
                                        Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.AutomationId="OpenFileEntryButton" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="FileEmptyText"
                        Grid.Row="1"
                        Text="This folder is empty or could not be read."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="FileProgress"
                            Minimum="0"
                            Maximum="100"
                            AutomationProperties.AutomationId="FileProgress" />
                        <TextBlock
                            x:Name="FileStatusText"
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="420" />
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Intents" IsClosable="False">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Start an activity" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox x:Name="IntentActionBox" Header="Action" PlaceholderText="android.intent.action.VIEW" AutomationProperties.AutomationId="IntentActionBox" />
                        <TextBox x:Name="IntentDataBox" Header="Data URI" PlaceholderText="https://example.com" AutomationProperties.AutomationId="IntentDataBox" />
                        <TextBox x:Name="IntentMimeBox" Header="MIME type" PlaceholderText="text/plain" AutomationProperties.AutomationId="IntentMimeBox" />
                        <TextBox x:Name="IntentPackageBox" Header="Package" PlaceholderText="com.example.app" AutomationProperties.AutomationId="IntentPackageBox" />
                        <TextBox x:Name="IntentComponentBox" Header="Component" PlaceholderText="com.example.app/.MainActivity" AutomationProperties.AutomationId="IntentComponentBox" />
                        <TextBox x:Name="IntentCategoriesBox" Header="Categories (comma separated)" AutomationProperties.AutomationId="IntentCategoriesBox" />
                        <TextBox x:Name="IntentFlagsBox" Header="Flags (integer)" PlaceholderText="0x10000000" AutomationProperties.AutomationId="IntentFlagsBox" />
                        <CheckBox x:Name="IntentWaitCheck" Content="Wait for the launch result" IsChecked="True" AutomationProperties.AutomationId="IntentWaitCheck" />
                        <TextBlock Text="Extras" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,0" />
                        <ItemsControl x:Name="IntentExtrasList" AutomationProperties.AutomationId="IntentExtrasList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Key, Mode=TwoWay}" PlaceholderText="key" />
                                        <ComboBox
                                            Grid.Column="1"
                                            ItemsSource="{Binding Types}"
                                            SelectedItem="{Binding Type, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" />
                                        <Button Grid.Column="3" Content="Remove" Click="OnRemoveExtraClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add extra" Click="OnAddIntentExtraClick" AutomationProperties.AutomationId="AddIntentExtraButton" />
                            <Button Content="Send intent" Click="OnSendIntentClick" AutomationProperties.AutomationId="SendIntentButton" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Broadcasts" IsClosable="False">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Send a broadcast" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBox x:Name="BroadcastActionBox" Header="Action" PlaceholderText="com.example.REFRESH" AutomationProperties.AutomationId="BroadcastActionBox" />
                        <TextBox x:Name="BroadcastPackageBox" Header="Package (optional)" AutomationProperties.AutomationId="BroadcastPackageBox" />
                        <TextBox x:Name="BroadcastComponentBox" Header="Component (optional)" AutomationProperties.AutomationId="BroadcastComponentBox" />
                        <CheckBox
                            x:Name="BroadcastStoppedCheck"
                            Content="Include stopped packages"
                            IsChecked="True"
                            AutomationProperties.AutomationId="BroadcastStoppedCheck" />
                        <TextBlock Text="Extras" Style="{StaticResource SectionHeaderStyle}" Margin="0,6,0,0" />
                        <ItemsControl x:Name="BroadcastExtrasList" AutomationProperties.AutomationId="BroadcastExtrasList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Key, Mode=TwoWay}" PlaceholderText="key" />
                                        <ComboBox
                                            Grid.Column="1"
                                            ItemsSource="{Binding Types}"
                                            SelectedItem="{Binding Type, Mode=TwoWay}" />
                                        <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" />
                                        <Button Grid.Column="3" Content="Remove" Click="OnRemoveExtraClick" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Add extra" Click="OnAddBroadcastExtraClick" AutomationProperties.AutomationId="AddBroadcastExtraButton" />
                            <Button Content="Send broadcast" Click="OnSendBroadcastClick" AutomationProperties.AutomationId="SendBroadcastButton" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Reboot" IsClosable="False">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Reboot the device" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            Text="The device disconnects immediately. Each option asks for confirmation that names the target mode."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button Content="Reboot to system" Click="OnRebootSystemClick" AutomationProperties.AutomationId="RebootSystemButton" />
                        <Button Content="Reboot to recovery" Click="OnRebootRecoveryClick" AutomationProperties.AutomationId="RebootRecoveryButton" />
                        <Button Content="Reboot to bootloader" Click="OnRebootBootloaderClick" AutomationProperties.AutomationId="RebootBootloaderButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Plugins" IsClosable="False">
                <Grid Padding="12" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Device actions" Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock
                                Text="Actions are isolated with a timeout. Their source is shown for every entry."
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ListView
                            x:Name="PluginActionList"
                            Grid.Row="1"
                            SelectionMode="None"
                            AutomationProperties.AutomationId="PluginDeviceActionList">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,5" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Action.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding Subtitle}"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Content="Run"
                                            VerticalAlignment="Center"
                                            Click="OnRunPluginActionClick"
                                            AutomationProperties.AutomationId="{Binding RunId}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="PluginEmptyText"
                            Grid.Row="1"
                            Text="No plugin device actions are registered."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Column="1" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Plugin tabs" Style="{StaticResource SectionHeaderStyle}" />
                        <TabView
                            x:Name="PluginTabs"
                            Grid.Row="1"
                            IsAddTabButtonVisible="False"
                            CanDragTabs="False"
                            CanReorderTabs="False"
                            AutomationProperties.AutomationId="PluginDeviceTabs" />
                        <TextBlock
                            x:Name="PluginTabEmptyText"
                            Grid.Row="1"
                            Text="No plugin tabs are registered for this device."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Tools" IsClosable="False">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Performance and inspector" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            Text="Open the host tools for this device. Both use adb shell commands and show the exact command that ran."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button Content="Open performance metrics" Click="OnOpenPerformanceClick" AutomationProperties.AutomationId="OpenPerformanceButton" />
                        <Button Content="Open UI inspector" Click="OnOpenInspectorClick" AutomationProperties.AutomationId="OpenInspectorButton" />
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>

        <Expander
            x:Name="OutputExpander"
            Grid.Row="3"
            Header="Command output"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            AutomationProperties.AutomationId="ToolboxOutputExpander">
            <StackPanel Spacing="6">
                <InfoBar
                    x:Name="ResultBar"
                    Severity="Success"
                    IsOpen="False"
                    IsClosable="True"
                    AutomationProperties.AutomationId="ToolboxResultBar" />
                <TextBlock
                    x:Name="ResultCommandText"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    IsTextSelectionEnabled="True" />
                <TextBox
                    x:Name="ResultOutputText"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    MaxHeight="220"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="ToolboxResultOutput" />
            </StackPanel>
        </Expander>
    </Grid>
</Page>
