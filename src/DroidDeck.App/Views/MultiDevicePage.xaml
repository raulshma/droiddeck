<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DroidDeck.App.Views.MultiDevicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    Text="{StaticResource Loc.page.multi-device.title}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    Text="Build a project once and install it on several devices. Each device gets an independent session, logs, and status; failed installs retry without rebuilding."
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button
                    Content="Refresh"
                    Click="OnRefreshClick"
                    AutomationProperties.AutomationId="RefreshMultiDeviceButton" />
                <Button
                    Content="Projects"
                    Click="OnOpenProjectsClick"
                    AutomationProperties.AutomationId="OpenProjectsButton" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                x:Name="ActionBar"
                Severity="Success"
                IsOpen="False"
                IsClosable="True"
                AutomationProperties.AutomationId="MultiDeviceActionBar" />
            <InfoBar
                x:Name="GuidanceBar"
                Severity="Informational"
                Title="Next step"
                IsOpen="False"
                IsClosable="False"
                AutomationProperties.AutomationId="MultiDeviceGuidanceBar" />
            <ProgressBar
                x:Name="BusyProgress"
                IsIndeterminate="True"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="MultiDeviceProgress" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Target" Style="{StaticResource SectionHeaderStyle}" />
                    <ComboBox
                        x:Name="ProjectCombo"
                        Grid.Row="1"
                        Header="Project"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnProjectChanged"
                        AutomationProperties.AutomationId="MultiDeviceProjectCombo" />
                    <ComboBox
                        x:Name="ConfigurationCombo"
                        Grid.Row="2"
                        Header="Run configuration"
                        DisplayMemberPath="Name"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="MultiDeviceConfigCombo" />
                    <ComboBox
                        x:Name="TagCombo"
                        Grid.Row="3"
                        Header="Device tag"
                        HorizontalAlignment="Stretch"
                        SelectionChanged="OnTagChanged"
                        AutomationProperties.AutomationId="MultiDeviceTagCombo" />

                    <Grid Grid.Row="5" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Devices" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Content="All" Click="OnSelectAllClick" FontSize="12" Padding="8,2" />
                                <Button Content="None" Click="OnSelectNoneClick" FontSize="12" Padding="8,2" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="DeviceList"
                            Grid.Row="1"
                            SelectionMode="Multiple"
                            SelectionChanged="OnDeviceSelectionChanged"
                            Padding="0,2,0,4"
                            AutomationProperties.AutomationId="MultiDeviceDeviceList">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,4" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding Detail}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <TextBlock
                        x:Name="SelectionText"
                        Grid.Row="6"
                        Text="No devices selected."
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <StackPanel Grid.Row="7" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RunButton"
                                Content="Build and run"
                                Click="OnRunClick"
                                Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="MultiDeviceRunButton" />
                            <Button
                                x:Name="DryRunButton"
                                Content="Dry run"
                                Click="OnDryRunClick"
                                AutomationProperties.AutomationId="MultiDeviceDryRunButton" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CancelButton"
                                Content="Cancel"
                                Click="OnCancelClick"
                                AutomationProperties.AutomationId="MultiDeviceCancelButton" />
                            <Button
                                x:Name="RetryButton"
                                Content="Retry failed"
                                Click="OnRetryClick"
                                AutomationProperties.AutomationId="MultiDeviceRetryButton" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            x:Name="GroupStateText"
                            Text="No multi-device run yet."
                            FontSize="16"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            AutomationProperties.AutomationId="MultiDeviceGroupState" />
                        <TextBlock
                            x:Name="GroupSummaryText"
                            Text="Select a project, configuration, and at least one device."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="GroupDetailsText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <ProgressBar
                            x:Name="GroupProgress"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            AutomationProperties.AutomationId="MultiDeviceGroupProgress" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                    <Grid>
                        <TabView
                            x:Name="DeviceTabs"
                            TabWidthMode="SizeToContent"
                            IsAddTabButtonVisible="False"
                            CanDragTabs="False"
                            CanReorderTabs="True"
                            AutomationProperties.AutomationId="MultiDeviceTabs" />
                        <TextBlock
                            x:Name="TabsEmptyText"
                            Text="Per-device tabs appear here when a run starts. Each tab keeps its own log position and filter."
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="380" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
