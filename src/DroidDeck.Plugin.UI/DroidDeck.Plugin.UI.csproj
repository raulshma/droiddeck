<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(DroidDeckWindowsTargetFramework)</TargetFramework>
    <TargetPlatformMinVersion>$(DroidDeckWindowsMinVersion)</TargetPlatformMinVersion>
    <RootNamespace>DroidDeck.Plugin.UI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <IsPackable>true</IsPackable>
    <PackageId>DroidDeck.Plugin.UI</PackageId>
    <Description>WinUI component kit and renderer contracts for DroidDeck plugins.</Description>
    <Authors>DroidDeck contributors</Authors>
    <Company>DroidDeck contributors</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>$(DroidDeckRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(DroidDeckRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>droiddeck;plugins;winui;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DroidDeck.Plugin.Abstractions\DroidDeck.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
