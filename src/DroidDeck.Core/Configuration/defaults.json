{
  "schemaVersion": 1,
  "appearance": {
    "theme": "system",
    "density": "comfortable",
    "motion": "full"
  },
  "tools": {
    "adbPath": null,
    "androidSdkPath": null,
    "aapt2Path": null,
    "emulatorPath": null,
    "javaHome": null,
    "gradlePath": null,
    "flutterPath": null,
    "nodePath": null,
    "scrcpyPath": null,
    "unityPath": null
  },
  "logging": {
    "level": "information",
    "maxUiLines": 20000,
    "retentionDays": 14,
    "maxSessionBytes": 2147483648
  },
  "diagnostics": {
    "inMemoryLogEntries": 2000,
    "recentErrorCount": 100
  },
  "features": {
    "developerMode": false,
    "safeMode": false
  },
  "window": {
    "width": 1280,
    "height": 800,
    "x": null,
    "y": null,
    "isMaximized": false
  },
  "projects": {
    "scanDepth": 3,
    "maxScanFolders": 2000,
    "scanTimeoutSeconds": 5,
    "ignoreFolders": [
      ".git",
      ".gradle",
      ".idea",
      "build",
      "node_modules",
      "dist",
      "out",
      "Pods",
      ".dart_tool",
      ".vs",
      "bin",
      "obj",
      "packages"
    ],
    "scanMonorepos": true
  },
  "notifications": {
    "enabled": true,
    "runSucceeded": true,
    "runFailed": true,
    "runCancelled": false,
    "crash": true,
    "installFailed": true
  }
}
