<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DroidDeck.Plugin.Abstractions</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>DroidDeck.Plugin.Abstractions</PackageId>
    <Description>Contracts for building DroidDeck plugins: lifecycle, extension points, logging, settings, test runners, and renderer data.</Description>
    <Authors>DroidDeck contributors</Authors>
    <Company>DroidDeck contributors</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>$(DroidDeckRepositoryUrl)</PackageProjectUrl>
    <RepositoryUrl>$(DroidDeckRepositoryUrl)</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>droiddeck;plugins;android;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
